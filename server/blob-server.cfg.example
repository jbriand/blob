# blob-server configuration — every key with its default value.
#
# Copy this file to `blob-server.cfg` next to the binary (or point at it with
# `blob-server --config <path>`). Flat `key = value` lines; `#` starts a
# comment, full-line or trailing; blank lines are fine. A typo'd or out-of-range
# value makes the server print every problem and refuse to start — it never
# falls back to defaults silently. CLI port beats this file: `blob-server 7878`.

port = 7777                   # UDP port the host listens on
max_clients = 64              # peer slots on the ENet host (>= 1)
tick_rate = 20                # simulation Hz; sent to clients in Welcome (u8: 1..255)
world_extent = 8192           # side of the square world, world units (u16 wire bound: up to 65535)
base_speed = 720              # speed of a mass-10 cell, world units/s — overall game pace
speed_mass_exponent = -0.44   # mass->speed falloff; keep negative or the biggest cell is also the fastest
radius_factor = 4             # drawn/collision radius = radius_factor * sqrt(mass)
grid_cell_size = 256          # broad-phase bucket side, world units (> 0)
eat_ratio = 1.25              # a cell eats a cell only above this mass ratio (> 1)
eat_depth_factor = 0.333333   # victim centre must be inside eater by this fraction of the victim's radius (0..1]
target_pellet_count = 2000    # the pellet field refills to this every tick (>= 0)
pellet_mass = 1               # mass of one pellet (> 0)
spawn_mass = 10               # starting cell mass for a fresh or respawned player (> 0)
decay_threshold = 200         # decay taxes only mass above this line, and floors at it (>= 0)
decay_rate = 0.002            # exponential decay lambda per second (>= 0; 0 disables decay)
min_split_mass = 36           # a cell splits only at or above this mass (> 0)
max_cells_per_player = 16     # hard cap on cells per player (>= 1)
split_impulse_speed = 780     # launch speed of the split half, world units/s (>= 0)
impulse_damping_rate = 3.5    # exponential damping lambda for impulses and ejected mass (>= 0)
merge_cooldown_base = 10      # seconds before split halves may remerge (>= 0)
merge_cooldown_per_mass = 0.02  # extra cooldown seconds per unit of mass at split time (>= 0)
merge_overlap = 0.25          # centres closer than this fraction of the bigger radius merge (0..1]
min_eject_mass = 35           # a cell ejects only at or above this mass (> 0, >= eject_mass_cost)
eject_mass_cost = 18          # mass the cell pays per eject (> 0)
ejected_mass = 14             # mass the ejected pellet carries (> 0, <= eject_mass_cost — the rest evaporates)
eject_speed = 1400            # launch speed of the ejected pellet, world units/s (>= 0)
target_virus_count = 40       # the virus field refills to this every tick (>= 0)
virus_mass = 100              # mass of a fresh virus (> 0)
virus_pop_pieces = 8          # pieces a virus pop tries to burst a cell into (>= 2)
virus_feed_count = 7          # ejected-mass hits before a fed virus splits (>= 1)
safe_spawn_radius = 600       # spawn keeps this clear of threatening cells (>= 0)
safe_spawn_threat_mass = 80   # a cell at or above this counts as a spawn threat (> 0)
safe_spawn_attempts = 16      # bounded spawn placement retries; the last attempt stands (>= 1)
view_base = 640               # visible radius at zero mass, world units (> 0)
view_mass_factor = 24         # visible radius grows by this * sqrt(total mass) (>= 0)
snapshot_chunks_per_tick = 3  # per-peer snapshot budget, chunks per tick (>= 1; 91 entities each)
